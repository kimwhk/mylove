---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const links = [
  { href: '', label: 'Inicio', icon: '🌸' },
  { href: 'contador/', label: 'Contador', icon: '⏳' },
  { href: 'sorpresas/', label: 'Sorpresas', icon: '💌' },
  { href: 'mensajes/', label: 'Secretos', icon: '🧸' },
  { href: 'juego/', label: 'Juego', icon: '🎮' },
];

const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '');
---

<header class="nav" id="site-nav">
  <div class="container row">
    <a class="brand" href={base} aria-label="Inicio">
      <span class="brand-text">Woonhak 🐱 Sungho</span>
    </a>

    <nav class="nav-inline" aria-label="Principal">
      {
        links.map((l) => {
          const path = l.href.replace(/\/$/, '');
          const isActive = current === path;
          return (
            <a href={`${base}${l.href}`} class:list={[{ active: isActive }]}>
              <span class="icn" aria-hidden="true">{l.icon}</span>
              <span class="lbl">{l.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="nav-actions">
      <span class="nav-toggle-wrap"><ThemeToggle /></span>
      <button
        id="nav-toggle"
        class="burger"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Drawer y backdrop FUERA del header para evitar conflictos de stacking context -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
<aside class="drawer" id="drawer" aria-hidden="true" aria-label="Menú">
  <nav class="drawer-nav" aria-label="Principal móvil">
    {
      links.map((l) => {
        const path = l.href.replace(/\/$/, '');
        const isActive = current === path;
        return (
          <a href={`${base}${l.href}`} class:list={[{ active: isActive }]} data-drawer-link>
            <span class="d-icn" aria-hidden="true">{l.icon}</span>
            <span class="d-lbl">{l.label}</span>
          </a>
        );
      })
    }
  </nav>
</aside>

<style>
  /* ===========================
     Layout base (desktop ≥ 1024px)
     =========================== */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    border-bottom: 1px solid var(--border);
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    transition: z-index 0s;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    position: relative;
    min-height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    font-family: 'Press Start 2P', sans-serif;
    font-size: clamp(10px, 1.6vw, 14px);
    text-decoration: none;
    flex: 0 1 auto;
    min-width: 0;
    padding: 4px 6px 4px 2px;
  }
  .brand-text {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-inline {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-inline a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    padding: 8px 10px;
    border-radius: 8px;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nav-inline a:hover { background: var(--surface-2); }
  .nav-inline a.active {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 14%, transparent);
  }

  /* Acciones a la derecha: toggle (siempre) + hamburguesa (mobile) */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* Hamburguesa, drawer y backdrop ocultos en desktop */
  .burger { display: none; }
  .drawer-backdrop, .drawer { display: none; }

  /* ===========================
     Tablet (≤ 1024px): solo iconos en links
     =========================== */
  @media (max-width: 1024px) {
    .nav-inline a .lbl { display: none; }
    .nav-inline a {
      padding: 8px;
      font-size: 18px;
    }
  }

  /* ===========================
     Mobile (≤ 760px): hamburguesa + drawer afuera
     =========================== */
  @media (max-width: 760px) {
    .row {
      padding: 12px 0;
      gap: 8px;
    }
    .brand {
      padding-left: 6px;
      font-size: 11px;
      max-width: 58vw;
    }
    .nav-inline { display: none; }

    .burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      width: 44px;
      height: 44px;
      padding: 12px 9px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.15s ease;
      flex-shrink: 0;
    }
    .burger:hover { background: var(--surface-2); }
    .burger span {
      display: block;
      width: 100%;
      height: 3px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.25s ease, opacity 0.2s ease;
    }

    /* Backdrop: SIEMPRE en DOM pero invisible hasta que abre */
    .drawer-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(5, 10, 25, 0.5);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 150;
    }

    .drawer {
      display: block;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(82vw, 320px);
      background: var(--surface);
      border-left: 1px solid var(--border);
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.22);
      padding: 76px 18px 24px;
      padding-right: max(18px, env(safe-area-inset-right));
      transform: translateX(100%);
      transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
      z-index: 160;
      overflow-y: auto;
      will-change: transform;
    }

    .drawer-nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .drawer-nav a {
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
      font-size: 16px;
      padding: 14px 14px;
      border-radius: 12px;
      transition: background 0.2s ease;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .drawer-nav a:hover { background: var(--surface-2); }
    .drawer-nav a.active {
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 14%, transparent);
    }
    .drawer-nav .d-icn { font-size: 22px; }

    /* Abierto: nav se eleva por encima del drawer para que la X
       (hamburguesa transformada) siga clickeable */
    body.nav-open .nav { z-index: 165; }
    body.nav-open .drawer-backdrop {
      opacity: 1;
      visibility: visible;
    }
    body.nav-open .drawer { transform: translateX(0); }
    body.nav-open .burger span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }
    body.nav-open .burger span:nth-child(2) { opacity: 0; }
    body.nav-open .burger span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }
  }

  /* ===========================
     Mobile chico (≤ 380px)
     =========================== */
  @media (max-width: 380px) {
    .brand { font-size: 10px; max-width: 52vw; padding-left: 4px; }
    .row { padding: 10px 0; min-height: 48px; }
  }
</style>

<style is:global>
  body.nav-open { overflow: hidden; }
  /* Aire extra en el container para mobile */
  @media (max-width: 760px) {
    .container { padding: 0 max(18px, env(safe-area-inset-left)) 0 max(18px, env(safe-area-inset-right)); }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const backdrop = document.getElementById('drawer-backdrop');
  const drawer = document.getElementById('drawer');

  function setOpen(open: boolean) {
    if (!nav || !toggle || !drawer) return;
    document.body.classList.toggle('nav-open', open);
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  toggle?.addEventListener('click', () => {
    setOpen(!document.body.classList.contains('nav-open'));
  });

  backdrop?.addEventListener('click', () => setOpen(false));

  drawer?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('nav-open')) {
      setOpen(false);
    }
  });

  // Cierra si se redimensiona a desktop
  let lastW = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth > 760 && lastW <= 760) setOpen(false);
    lastW = window.innerWidth;
  });
</script>
