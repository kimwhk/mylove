---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const links = [
  { href: '', label: 'Inicio', icon: '🌸' },
  { href: 'contador/', label: 'Contador', icon: '⏳' },
  { href: 'sorpresas/', label: 'Sorpresas', icon: '💌' },
  { href: 'mensajes/', label: 'Secretos', icon: '🧸' },
  { href: 'juego/', label: 'Juego', icon: '🎮' },
];

const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '');
---

<header class="nav">
  <div class="container row">
    <a class="brand" href={base}>
      <span class="pixel" aria-hidden="true">💙</span>
      <span class="brand-text">Kim &amp; Sungho</span>
    </a>

    <input id="nav-toggle" type="checkbox" aria-label="Abrir menú" />
    <label for="nav-toggle" class="burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="links">
      {
        links.map((l) => {
          const path = l.href.replace(/\/$/, '');
          const isActive = current === path;
          return (
            <a href={`${base}${l.href}`} class:list={[{ active: isActive }]}>
              <span aria-hidden="true">{l.icon}</span> {l.label}
            </a>
          );
        })
      }
      <span class="toggle-wrap"><ThemeToggle /></span>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    position: relative;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: 'Press Start 2P', sans-serif;
    font-size: 14px;
    text-decoration: none;
  }
  .brand-text {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .pixel {
    width: 22px;
    height: 22px;
    display: inline-grid;
    place-items: center;
    font-size: 16px;
    background: var(--surface-2);
    border-radius: 6px;
    box-shadow: var(--pixel-shadow);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .links a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    padding: 6px 10px;
    border-radius: 8px;
    transition: background 0.2s ease;
  }
  .links a:hover { background: var(--surface-2); }
  .links a.active {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 14%, transparent);
  }
  .toggle-wrap { margin-left: 4px; }

  /* Hamburguesa mobile */
  #nav-toggle { display: none; }
  .burger { display: none; }

  @media (max-width: 720px) {
    .burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: space-between;
      width: 26px; height: 18px;
      cursor: pointer;
    }
    .burger span {
      display: block;
      height: 3px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.25s ease, opacity 0.2s ease;
    }
    .links {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 12px 16px 18px;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      transform: translateY(-10px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    #nav-toggle:checked ~ .links {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    #nav-toggle:checked ~ .burger span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    #nav-toggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
    #nav-toggle:checked ~ .burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .links a {
      padding: 12px;
      font-size: 16px;
    }
  }
</style>
