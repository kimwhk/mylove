---
// Estrellitas y corazones flotantes; respeta prefers-reduced-motion.
const stars = Array.from({ length: 40 }).map(() => ({
  top: Math.random() * 100,
  left: Math.random() * 100,
  delay: Math.random() * 4,
  size: 2 + Math.random() * 3,
}));

const hearts = Array.from({ length: 8 }).map((_, i) => ({
  left: 5 + Math.random() * 90,
  delay: i * 1.1,
  duration: 8 + Math.random() * 6,
  size: 16 + Math.random() * 16,
}));
---

<div class="sky" aria-hidden="true">
  {
    stars.map((s) => (
      <span
        class="dot"
        style={`top:${s.top}%; left:${s.left}%; width:${s.size}px; height:${s.size}px; animation-delay:${s.delay}s;`}
      />
    ))
  }
  {
    hearts.map((h) => (
      <span
        class="float-heart"
        style={`left:${h.left}%; animation-delay:${h.delay}s; animation-duration:${h.duration}s; font-size:${h.size}px;`}
      >
        ♥
      </span>
    ))
  }
</div>
