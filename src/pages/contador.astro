---
import Layout from '../layouts/Layout.astro';
import PixelChar from '../components/PixelChar.astro';

// === Editable: fecha de inicio de la relación ===
const startISO = '2025-11-20T00:00:00';
---

<Layout title="Contador en vivo · Woonhak & Sungho">
  <section class="container contador">
    <header class="head">
      <p class="eyebrow">⏳ TIEMPO JUNTOS</p>
      <h1>Llevamos <span id="big-days" class="big">…</span> días juntos</h1>
      <p class="sub">Y cada segundo cuenta, literalmente. Desde el <strong>20 · 11 · 2025</strong>.</p>
    </header>

    <div class="grid" id="counter-grid" data-start={startISO}>
      <div class="cell card">
        <span class="num" data-k="days">0</span>
        <span class="lbl">días</span>
      </div>
      <div class="cell card">
        <span class="num" data-k="hours">0</span>
        <span class="lbl">horas</span>
      </div>
      <div class="cell card">
        <span class="num" data-k="minutes">0</span>
        <span class="lbl">minutos</span>
      </div>
      <div class="cell card gold-cell">
        <span class="num" data-k="seconds">0</span>
        <span class="lbl">segundos</span>
      </div>
    </div>

    <div class="quote card">
      <p>
        "Seis meses se dicen rápido, pero son <strong>4,380 horas</strong> de
        risas, <strong>262,800 minutos</strong> de aprender a quererte,
        y un montón de tardes con Simba arriba de los dos."
      </p>
    </div>

    <div class="trio">
      <PixelChar name="woonhak" size={84} bobbing label="Woonhak" />
      <PixelChar name="simba" size={96} bobbing label="Simba" />
      <PixelChar name="sungho" size={84} bobbing label="Sungho" />
    </div>
  </section>
</Layout>

<style>
  .contador { padding-top: clamp(20px, 5vw, 40px); }
  .head { text-align: center; margin-bottom: 28px; }
  .eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    letter-spacing: 0.12em;
  }
  .big {
    font-family: 'Press Start 2P', monospace;
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: var(--text-soft); }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 24px 0;
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  .cell {
    text-align: center;
    padding: 22px 12px;
  }
  .num {
    display: block;
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(1.4rem, 5vw, 2.4rem);
    color: var(--primary);
    line-height: 1.1;
    transition: transform 0.2s ease;
  }
  .gold-cell .num { color: var(--gold); }
  .lbl {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .num.pulse { transform: scale(1.18); }

  .quote {
    text-align: center;
    color: var(--text-soft);
    border-left: 4px solid var(--gold);
  }
  .quote p { margin: 0; font-size: 15px; }

  .trio {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(14px, 4vw, 36px);
    margin-top: 32px;
    flex-wrap: wrap;
  }
</style>

<script>
  const grid = document.getElementById('counter-grid');
  const bigDays = document.getElementById('big-days');
  if (grid && bigDays) {
    const start = new Date(grid.getAttribute('data-start') || '');
    const cells: Record<string, HTMLElement> = {};
    grid.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => {
      cells[el.dataset.k!] = el;
    });

    let lastSec = -1;
    const tick = () => {
      const now = new Date();
      const diff = Math.max(0, now.getTime() - start.getTime());
      const sec = Math.floor(diff / 1000);
      const days = Math.floor(sec / 86400);
      const hours = Math.floor((sec % 86400) / 3600);
      const minutes = Math.floor((sec % 3600) / 60);
      const seconds = sec % 60;

      bigDays.textContent = days.toLocaleString('es');
      cells.days.textContent = String(days);
      cells.hours.textContent = String(hours).padStart(2, '0');
      cells.minutes.textContent = String(minutes).padStart(2, '0');
      cells.seconds.textContent = String(seconds).padStart(2, '0');

      if (seconds !== lastSec) {
        cells.seconds.classList.add('pulse');
        setTimeout(() => cells.seconds.classList.remove('pulse'), 160);
        lastSec = seconds;
      }
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
