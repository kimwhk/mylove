---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sorpresas · para Sungho 💌">
  <section class="container sorp">
    <header class="head">
      <p class="eyebrow">💌 ÁBRELO CUANDO…</p>
      <h1>Botones <span class="grad">sorpresa</span></h1>
      <p class="sub">Aprieta uno y deja que aparezca algo lindo. Cada click es una mini-carta.</p>
    </header>

    <div class="cards">
      <button class="surprise card" data-set="triste">
        <span class="ico">🌧️</span>
        <h3>Abrir cuando estés triste</h3>
        <p>Para esos días que se sienten más pesados.</p>
      </button>

      <button class="surprise card" data-set="razones">
        <span class="ico">💛</span>
        <h3>Razones por las que te amo</h3>
        <p>Una al azar, pero todas son verdad.</p>
      </button>

      <button class="surprise card" data-set="recompensa">
        <span class="ico">🎁</span>
        <h3>Tu recompensa diaria</h3>
        <p>Una sola por día. (Honor system.)</p>
      </button>

      <button class="surprise card" data-set="nervios">
        <span class="ico">🫧</span>
        <h3>Abrir cuando estés nervioso</h3>
        <p>Respira y lee esto.</p>
      </button>

      <button class="surprise card" data-set="extranar">
        <span class="ico">🌙</span>
        <h3>Abrir cuando me extrañes</h3>
        <p>Yo también, siempre.</p>
      </button>

      <button class="surprise card" data-set="aniv">
        <span class="ico">✨</span>
        <h3>Solo por hoy (6 meses)</h3>
        <p>Mensaje exclusivo del aniversario.</p>
      </button>
    </div>
  </section>

  <!-- Modal -->
  <div id="overlay" class="overlay" hidden>
    <div class="modal card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button class="x" id="close-modal" aria-label="Cerrar">✕</button>
      <div class="ico-big" id="modal-ico">🩵</div>
      <h2 id="modal-title">Mensaje</h2>
      <p id="modal-body">…</p>
      <button class="btn" id="another">Otro 🎲</button>
    </div>
  </div>
</Layout>

<style>
  .sorp { padding-top: clamp(20px, 5vw, 40px); }
  .head { text-align: center; margin-bottom: 28px; }
  .eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    letter-spacing: 0.12em;
  }
  .grad {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: var(--text-soft); }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 860px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .cards { grid-template-columns: 1fr; } }

  .surprise {
    text-align: left;
    cursor: pointer;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    transition: transform 0.18s ease, box-shadow 0.2s ease, border-color 0.2s;
  }
  .surprise:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(46, 111, 196, 0.18);
    border-color: var(--primary);
  }
  .surprise .ico { font-size: 28px; }
  .surprise h3 { font-size: 14px; margin: 8px 0 4px; }
  .surprise p { font-size: 13px; color: var(--text-soft); margin: 0; }

  /* Modal */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 10, 25, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    z-index: 100;
    padding: 20px;
    animation: fade 0.25s ease;
  }
  .overlay[hidden] { display: none !important; }
  @keyframes fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .modal {
    max-width: 480px;
    width: 100%;
    text-align: center;
    position: relative;
    animation: rise-in 0.3s ease;
    border-top: 4px solid var(--gold);
  }
  @keyframes rise-in {
    from { transform: translateY(20px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  .x {
    position: absolute;
    top: 10px; right: 12px;
    background: transparent;
    border: none;
    color: var(--text-soft);
    font-size: 18px;
    cursor: pointer;
  }
  .ico-big { font-size: 42px; margin: 6px 0 10px; }
  .modal h2 { font-size: 16px; margin: 0 0 8px; }
  .modal p {
    color: var(--text-soft);
    font-size: 15px;
    margin: 0 0 18px;
    min-height: 2.5em;
  }
</style>

<script>
  type SetKey = 'triste' | 'razones' | 'recompensa' | 'nervios' | 'extranar' | 'aniv';

  const messages: Record<SetKey, { title: string; ico: string; lines: string[] }> = {
    triste: {
      title: 'Para los días grises',
      ico: '🌧️',
      lines: [
        'Aquí estoy. No tienes que sentirte bien para que esto valga la pena.',
        'Si hoy no puedes ser fuerte, te sostengo yo. Mañana también, si hace falta.',
        'Las cosas duras también pasan, mi amor. Y mientras pasan, tienes mi mano.',
        'No tienes que explicarme por qué estás triste. Solo cuéntame qué necesitas.',
        'Llorar no te hace menos. Te hace más humano y yo te elijo así.',
        'Simba se acuesta encima de los que están tristes. Yo también, si me dejas.',
      ],
    },
    razones: {
      title: 'Una razón por la que te amo',
      ico: '💛',
      lines: [
        'Por cómo te ríes cuando algo te emociona.',
        'Porque haces que lo cotidiano se sienta emocionante sin esfuerzo.',
        'Por tu empatía. Especialmente cuando no son buenos contigo.',
        'Por tu educada forma de maldecir en distintos momentos del día.',
        'Porque me dejas ser yo, sin disfraces, en mis mejores y peores horas.',
        'Por cómo miras a Simba, por como me miras a mí, eso me dice todo lo que necesito saber de ti.',
      ],
    },
    recompensa: {
      title: 'Tu recompensa diaria 🎁',
      ico: '🎁',
      lines: [
        'Vale por un abrazo de 30 segundos donde nadie cuenta el tiempo.',
        'Vale por elegir tú la peli esta noche, sin reclamos.',
        'Vale por un beso en la frente justo antes de dormir.',
        'Vale por un desayuno a la cama, yo lo preparo, soy tu sirviente.',
        'Vale por escucharte el día completo, sin interrumpir.',
        'Vale por una caricia en el pelo hasta que te duermas.',
      ],
    },
    nervios: {
      title: 'Respira: estoy contigo',
      ico: '🫧',
      lines: [
        'Respira. 4 segundos adentro. 7 lo sostienes. 8 lo sueltas. Otra vez. Sigo aquí.',
        'No importa si te dicen que no eres el mejor, para mí lo eres, que los demás se callen.',
        'Hagas lo que hagas hoy, te elijo mañana también, sin condiciones.',
        'Pase lo que pase: vuelves a casa donde siempre te estaré esperando.',
        'No tienes que tener todo bajo control. Tienes esto bajo control: a mí.',
        'Si necesitas que te lo recuerde: eres suficiente. Punto. Sin asterisco.',
      ],
    },
    extranar: {
      title: 'Yo también te extraño',
      ico: '🌙',
      lines: [
        'Cuando mires la luna piensa en nosotros, porque me recuerda a tí, y yo haré lo imposible para llegar a ella.',
        'Estás en mi mente también, en mi cuerpo y alma.',
        'No estoy lejos. Estoy en la próxima ventana del tiempo. Ya casi.',
        'Ponle play a esa canción que te cante, sabes cual es.',
        'Te extraño igual o más. Y eso es bueno: significa que esto es real.',
        'Hueles a casa para mí también.',
      ],
    },
    aniv: {
      title: '6 meses contigo · 20.05.2026',
      ico: '✨',
      lines: [
        'Seis meses se dicen rápido. Pero pesan bonito. Gracias por cada día.',
        'Hoy hace 6 meses dijiste que sí.',
        'Si esto es solo el principio, no me alcanzan los números para lo que viene.',
        'Medio año entendiendo que las mejores cosas no se planean, solo pasan.',
        'Aprendí más de mí en estos 6 meses que en años enteros. Gracias a ti.',
        'Te elegí, te elijo, y te elegiré. Esa conjugación me sale natural contigo.',
      ],
    },
  };

  const overlay = document.getElementById('overlay') as HTMLElement | null;
  const title = document.getElementById('modal-title');
  const body = document.getElementById('modal-body');
  const ico = document.getElementById('modal-ico');
  const closeBtn = document.getElementById('close-modal');
  const again = document.getElementById('another');
  let current: SetKey | null = null;
  let lastIdx = -1;

  function show(set: SetKey) {
    current = set;
    const data = messages[set];
    let idx = Math.floor(Math.random() * data.lines.length);
    if (data.lines.length > 1 && idx === lastIdx) idx = (idx + 1) % data.lines.length;
    lastIdx = idx;
    if (title) title.textContent = data.title;
    if (ico) ico.textContent = data.ico;
    if (body) body.textContent = data.lines[idx];
    overlay?.removeAttribute('hidden');
  }

  document.querySelectorAll<HTMLElement>('.surprise').forEach((b) => {
    b.addEventListener('click', () => {
      const k = b.dataset.set as SetKey;
      show(k);
    });
  });
  closeBtn?.addEventListener('click', () => overlay?.setAttribute('hidden', ''));
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.setAttribute('hidden', '');
  });
  again?.addEventListener('click', () => current && show(current));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') overlay?.setAttribute('hidden', '');
  });
</script>
