---
import Layout from '../layouts/Layout.astro';
import PixelChar from '../components/PixelChar.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Bienvenida a nuestro rincón 🩵">
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">06 MESES · 20·11·2025 → 20·05·2026</p>
      <h1>
        Bienvenida a nuestro
        <span class="grad">pequeño rincón</span>
        de internet
        <button id="heart-click5" class="heart-btn" type="button" aria-label="Corazón secreto">
          <span class="heart-pop">🩵</span>
        </button>
      </h1>
      <p class="lede">
        Un lugar hecho a pixel y a corazón para celebrar los seis meses más
        suaves del mundo. Pasea, presiona botones, atrapa corazones, y
        encuentra los detalles escondidos. <em>(Hay sorpresas por toda la página.)</em>
      </p>

      <div class="cta-row">
        <a class="btn" href={`${base}contador/`}>Ver contador ⏳</a>
        <a class="btn ghost" href={`${base}sorpresas/`}>Abrir sorpresas 💌</a>
        <a class="btn gold" href={`${base}juego/`}>Jugar 🎮</a>
      </div>
    </div>

    <div class="hero-art card">
      <div class="scene">
        <div class="ground"></div>
        <button class="char left" id="woonhak-wrap" type="button" aria-label="Woonhak (doble click)">
          <PixelChar name="woonhak" size={120} bobbing label="Woonhak" />
        </button>
        <button class="char center" id="simba-wrap" type="button" aria-label="Simba (pasa el mouse)">
          <PixelChar name="simba" size={140} bobbing label="Simba" />
        </button>
        <button class="char right" id="sungho-wrap" type="button" aria-label="Sungho">
          <PixelChar name="sungho" size={120} bobbing label="Sungho" />
        </button>
        <span class="cloud c1">☁️</span>
        <span class="cloud c2">☁️</span>
        <span class="cloud c3">⭐</span>
        <span class="cloud c4">⭐</span>

        <span id="bubble-simba" class="scene-bubble bubble-center">prrrr 🩵 te conoce</span>
        <span id="bubble-woonhak" class="scene-bubble bubble-left">te quiero, Sungho 🩵</span>
        <span id="bubble-sungho" class="scene-bubble bubble-right">mi favorito 💛</span>
      </div>
      <p class="caption">
        Pasa el mouse sobre Simba · doble-click a Woonhak · y… hay más.
      </p>
    </div>
  </section>

  <section class="features container">
    <a class="feat card" href={`${base}contador/`}>
      <div class="ico">⏳</div>
      <h3>Contador en vivo</h3>
      <p>Los días, horas y segundos que llevamos juntos, en tiempo real.</p>
    </a>
    <a class="feat card" href={`${base}sorpresas/`}>
      <div class="ico">💌</div>
      <h3>Botones sorpresa</h3>
      <p>"Abrir cuando estés triste", "Razones por las que te amo" y más.</p>
    </a>
    <a class="feat card" href={`${base}mensajes/`}>
      <div class="ico">🧸</div>
      <h3>Guía de secretos</h3>
      <p>¿Encontraste todos? Aquí te decimos cuáles hay y dónde.</p>
    </a>
    <a class="feat card" href={`${base}juego/`}>
      <div class="ico">🎮</div>
      <h3>Mini juego pixel</h3>
      <p>Atrapa corazones con Sungho. Cuidado con los rayos.</p>
    </a>
  </section>

  <!-- Tramo largo de scroll con hints intermedios -->
  <section class="container long-scroll" aria-hidden="true">
    <p class="hint h1">Sigue bajando…</p>
    <p class="hint h2">un poquito más 🩵</p>
    <p class="hint h3">¿confías en mí?</p>
    <p class="hint h4">ya casi…</p>
    <p class="hint h5">👀</p>
    <p class="hint h6">una más…</p>
    <p class="hint h7">🌟</p>
  </section>

  <section class="container bottom-easter">
    <div id="bottom-card" class="card bottom-card">
      <span class="ico">🌟</span>
      <h3>¡Lo encontraste! fondo del scroll</h3>
      <p>Premio por curiosa: aquí te dejo un beso invisible. (¿lo sentiste? 😌)</p>
      <button id="reopen-photo" class="btn ghost" type="button" style="margin-top:10px;">
        Volver a ver mi besito 💋
      </button>
    </div>
  </section>

  <div id="progress-chip" class="progress-chip" aria-live="polite" title="Secretos encontrados">
    <span aria-hidden="true">🧸</span>
    <span id="progress-text">0 / 6</span>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden>
    <span id="toast-icon">✨</span>
    <span id="toast-text">¡Secreto!</span>
  </div>

  <!-- Modal de foto para el secreto del scroll -->
  <div id="photo-modal" class="photo-modal" hidden role="dialog" aria-modal="true" aria-labelledby="photo-caption">
    <div class="photo-card card">
      <button class="photo-close" id="photo-close" type="button" aria-label="Cerrar">✕</button>
      <div class="photo-frame">
        <img id="photo-img" alt="Foto romántica" />
        <div id="photo-fallback" class="photo-fallback" hidden>
          <span class="ico">📷</span>
          <p>Aún no hay foto aquí.<br/>Pon una en <code>public/photos/N.jpg</code>.</p>
        </div>
      </div>
      <h2 id="photo-caption" class="photo-caption">un besito 💋</h2>
      <p class="photo-sub">por bajar hasta aquí.</p>
      <div class="photo-actions">
        <button id="photo-another" class="btn" type="button">Otra foto 🎲</button>
        <button id="photo-done" class="btn ghost" type="button">Cerrar</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    padding-top: clamp(20px, 5vw, 60px);
    padding-bottom: clamp(20px, 5vw, 40px);
  }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
  }
  .eyebrow {
    display: inline-block;
    margin: 0 0 14px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    letter-spacing: 0.12em;
  }
  .grad {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .heart-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 4px;
    vertical-align: -2px;
  }
  .heart-pop {
    display: inline-block;
    animation: pop 1.4s ease-in-out infinite;
  }
  .heart-btn.found .heart-pop { animation: pop 0.4s ease-in-out 4; }
  @keyframes pop {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.18); }
  }
  .lede {
    font-size: clamp(15px, 1.6vw, 17px);
    color: var(--text-soft);
    max-width: 52ch;
  }
  .lede em {
    color: var(--gold);
    font-style: normal;
    font-weight: 600;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 22px 0 14px;
  }
  .music {
    margin-top: 10px;
    background: transparent;
    color: var(--text-soft);
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    font-size: 13px;
    transition: background 0.2s ease;
  }
  .music:hover { background: var(--surface-2); }
  .music[aria-pressed='true'] {
    color: var(--gold);
    border-style: solid;
    border-color: var(--gold);
  }

  .hero-art { padding: 18px; }
  .scene {
    position: relative;
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--accent) 35%, transparent),
        color-mix(in srgb, var(--surface) 80%, transparent));
    border-radius: 14px;
    overflow: hidden;
  }
  .ground {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 22%;
    background:
      repeating-linear-gradient(
        45deg,
        color-mix(in srgb, var(--primary) 30%, transparent) 0 6px,
        color-mix(in srgb, var(--primary) 18%, transparent) 6px 12px
      );
  }
  .char {
    position: absolute;
    bottom: 14%;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .char:focus-visible { outline: 3px solid var(--gold); border-radius: 8px; }
  .char.left   { left: 6%; }
  .char.center { left: 50%; transform: translateX(-50%); bottom: 10%; }
  .char.right  { right: 6%; }
  .cloud {
    position: absolute;
    font-size: 22px;
    opacity: 0.85;
    animation: drift 14s linear infinite;
  }
  .cloud.c1 { top: 8%;  left: 10%; animation-duration: 16s; }
  .cloud.c2 { top: 16%; right: 18%; animation-duration: 22s; }
  .cloud.c3 { top: 30%; left: 38%; font-size: 14px; color: var(--gold); }
  .cloud.c4 { top: 10%; right: 8%; font-size: 14px; color: var(--gold); }
  @keyframes drift {
    0%   { transform: translateX(0); }
    50%  { transform: translateX(20px); }
    100% { transform: translateX(0); }
  }
  .caption {
    text-align: center;
    color: var(--text-soft);
    font-size: 13px;
    margin: 12px 0 0;
  }

  .scene-bubble {
    position: absolute;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 6px 10px;
    font-size: 12px;
    color: var(--text);
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    z-index: 3;
    white-space: nowrap;
  }
  .scene-bubble.show { opacity: 1; transform: translateY(0); }
  .bubble-center { top: 6%; left: 50%; transform: translate(-50%, 8px); }
  .bubble-center.show { transform: translate(-50%, 0); }
  .bubble-left   { top: 10%; left: 8%; }
  .bubble-right  { top: 10%; right: 8%; }

  .features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: clamp(20px, 4vw, 30px) auto;
  }
  @media (max-width: 860px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .features { grid-template-columns: 1fr; } }
  .feat {
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }
  .feat:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(46, 111, 196, 0.18);
    text-decoration: none;
  }
  .feat .ico { font-size: 28px; margin-bottom: 8px; }
  .feat h3 { font-size: 14px; margin: 0 0 6px; }
  .feat p { font-size: 13px; color: var(--text-soft); margin: 0; }

  /* Long scroll: hints intermedios espaciados */
  .long-scroll {
    padding: 80px 0 60px;
    text-align: center;
  }
  .long-scroll .hint {
    color: var(--text-soft);
    font-family: 'Press Start 2P', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    margin: 0 auto;
    opacity: 0.55;
  }
  .long-scroll .h1 { margin-top: 0;     }
  .long-scroll .h2 { margin-top: 28vh; opacity: 0.5; }
  .long-scroll .h3 { margin-top: 32vh; opacity: 0.45; }
  .long-scroll .h4 { margin-top: 36vh; opacity: 0.4; font-size: 13px; }
  .long-scroll .h5 { margin-top: 40vh; opacity: 0.5; font-size: 28px; }
  .long-scroll .h6 { margin-top: 30vh; opacity: 0.4; }
  .long-scroll .h7 { margin-top: 24vh; opacity: 0.65; font-size: 26px; color: var(--gold); }
  @media (max-width: 720px) {
    .long-scroll .h2 { margin-top: 32vh; }
    .long-scroll .h3 { margin-top: 36vh; }
    .long-scroll .h4 { margin-top: 36vh; }
    .long-scroll .h5 { margin-top: 40vh; }
  }

  .bottom-easter { padding-top: 8vh; padding-bottom: 100px; }
  .bottom-card {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    border: 2px dashed var(--gold);
    opacity: 0.45;
    transform: translateY(10px) scale(0.98);
    transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.4s;
  }
  .bottom-card.found {
    opacity: 1;
    transform: translateY(0) scale(1);
    border-color: var(--primary);
  }
  .bottom-card .ico { font-size: 36px; display: block; margin-bottom: 6px; }
  .bottom-card h3 { margin: 0 0 6px; }
  .bottom-card p { color: var(--text-soft); margin: 0; }

  .progress-chip {
    position: fixed;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: var(--text);
    z-index: 60;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 80px;
    transform: translate(-50%, 20px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--gold);
    border-radius: 14px;
    color: var(--text);
    font-size: 14px;
    box-shadow: var(--shadow);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 80;
    max-width: 92vw;
  }
  .toast[hidden] { display: none !important; }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .toast #toast-icon { font-size: 20px; }

  .idle-rain {
    position: fixed;
    top: -40px;
    font-size: 32px;
    line-height: 1;
    z-index: 75;
    pointer-events: none;
    text-shadow: 0 2px 6px rgba(0,0,0,0.2);
    animation: fall 5s linear forwards;
    will-change: transform, opacity;
  }
  @keyframes fall {
    0%   { transform: translateY(-40px) rotate(-8deg); opacity: 0; }
    8%   { opacity: 1; }
    90%  { opacity: 1; }
    100% { transform: translateY(110vh) rotate(20deg); opacity: 0; }
  }

  /* ===== Modal foto (scroll secret) ===== */
  .photo-modal {
    position: fixed;
    inset: 0;
    background: rgba(5, 10, 25, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: grid;
    place-items: center;
    z-index: 200;
    padding: 16px;
    animation: photo-fade 0.3s ease;
  }
  .photo-modal[hidden] { display: none !important; }
  @keyframes photo-fade {
    from { opacity: 0; } to { opacity: 1; }
  }
  .photo-card {
    max-width: 480px;
    width: 100%;
    text-align: center;
    position: relative;
    border-top: 4px solid var(--gold);
    animation: photo-rise 0.35s ease;
  }
  @keyframes photo-rise {
    from { transform: translateY(20px) scale(0.96); opacity: 0; }
    to   { transform: translateY(0) scale(1); opacity: 1; }
  }
  .photo-close {
    position: absolute;
    top: 8px; right: 12px;
    background: transparent;
    border: none;
    color: var(--text-soft);
    font-size: 20px;
    cursor: pointer;
    z-index: 2;
  }
  .photo-frame {
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    border-radius: 12px;
    overflow: hidden;
    margin: 6px 0 14px;
    position: relative;
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--text-soft);
    padding: 16px;
  }
  .photo-fallback[hidden] { display: none; }
  .photo-fallback .ico { font-size: 36px; display: block; margin-bottom: 8px; }
  .photo-fallback code {
    background: var(--surface);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 12px;
  }
  .photo-caption {
    font-size: 18px;
    margin: 0 0 4px;
    color: var(--text);
  }
  .photo-sub {
    color: var(--text-soft);
    margin: 0 0 18px;
    font-size: 14px;
  }
  .photo-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

<script>
  const SECRETS = ['hover-simba', 'dblclick-woonhak', 'heart5', 'typeamor', 'idle10', 'scroll-bottom'];
  const found = new Set<string>(
    (() => {
      try { return JSON.parse(localStorage.getItem('secrets-found') || '[]'); }
      catch { return []; }
    })()
  );
  const progressText = document.getElementById('progress-text');
  const updateProgress = () => {
    if (progressText) progressText.textContent = `${found.size} / ${SECRETS.length}`;
    localStorage.setItem('secrets-found', JSON.stringify([...found]));
  };
  updateProgress();

  const toast = document.getElementById('toast') as HTMLElement | null;
  const toastText = document.getElementById('toast-text');
  const toastIcon = document.getElementById('toast-icon');
  let toastTimer: number | null = null;
  function showToast(icon: string, text: string) {
    if (!toast || !toastText || !toastIcon) return;
    toastIcon.textContent = icon;
    toastText.textContent = text;
    toast.removeAttribute('hidden');
    requestAnimationFrame(() => toast.classList.add('show'));
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove('show');
      window.setTimeout(() => toast.setAttribute('hidden', ''), 350);
    }, 3200);
  }

  function discover(key: string, icon: string, text: string) {
    if (found.has(key)) return;
    found.add(key);
    updateProgress();
    showToast(icon, text);
    if (found.size === SECRETS.length) {
      window.setTimeout(() => showToast('🏆', '¡Encontraste todos los secretos! Te amo.'), 3500);
    }
  }

  // 1) Hover Simba
  const simbaWrap = document.getElementById('simba-wrap');
  const bubbleSimba = document.getElementById('bubble-simba');
  const showBubble = (el: HTMLElement | null) => el?.classList.add('show');
  const hideBubble = (el: HTMLElement | null) => el?.classList.remove('show');
  simbaWrap?.addEventListener('mouseenter', () => {
    showBubble(bubbleSimba);
    discover('hover-simba', '🐱', 'Simba ronronea al pasarle el mouse');
  });
  simbaWrap?.addEventListener('mouseleave', () => hideBubble(bubbleSimba));
  simbaWrap?.addEventListener('focus', () => showBubble(bubbleSimba));
  simbaWrap?.addEventListener('blur', () => hideBubble(bubbleSimba));
  simbaWrap?.addEventListener('click', () => {
    showBubble(bubbleSimba);
    discover('hover-simba', '🐱', 'Simba ronronea al tocarla');
    setTimeout(() => hideBubble(bubbleSimba), 2200);
  });

  // 2) Doble click en Woonhak
  const woonhakWrap = document.getElementById('woonhak-wrap');
  const bubbleWoonhak = document.getElementById('bubble-woonhak');
  woonhakWrap?.addEventListener('dblclick', () => {
    showBubble(bubbleWoonhak);
    discover('dblclick-woonhak', '🩵', 'Woonhak te quiere mucho, Sungho');
    setTimeout(() => hideBubble(bubbleWoonhak), 2500);
  });
  let lastTap = 0;
  woonhakWrap?.addEventListener('touchend', (e) => {
    const now = Date.now();
    if (now - lastTap < 400) {
      e.preventDefault();
      showBubble(bubbleWoonhak);
      discover('dblclick-woonhak', '🩵', 'Woonhak te quiere mucho, Sungho');
      setTimeout(() => hideBubble(bubbleWoonhak), 2500);
    }
    lastTap = now;
  });

  // Sungho hover bonus
  const sunghoWrap = document.getElementById('sungho-wrap');
  const bubbleSungho = document.getElementById('bubble-sungho');
  sunghoWrap?.addEventListener('mouseenter', () => showBubble(bubbleSungho));
  sunghoWrap?.addEventListener('mouseleave', () => hideBubble(bubbleSungho));

  // 3) Click 5 al corazón
  const heartBtn = document.getElementById('heart-click5');
  const clickMsgs = [
    'Hola 👋',
    '¿Otra vez? Bien…',
    'Te estoy mirando 👀',
    'Casi casi…',
    '✨ Te amo, gatito.',
  ];
  let heartCount = 0;
  heartBtn?.addEventListener('click', () => {
    heartCount++;
    heartBtn.classList.remove('found');
    void (heartBtn as HTMLElement).offsetWidth;
    heartBtn.classList.add('found');
    const idx = Math.min(heartCount - 1, clickMsgs.length - 1);
    showToast('🩵', clickMsgs[idx]);
    if (heartCount >= 5) discover('heart5', '🩵', 'Te toca pensar en algo lindo');
  });

  // 4) Escribir "amor"
  let buf = '';
  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement)?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key && e.key.length === 1) {
      buf = (buf + e.key.toLowerCase()).slice(-8);
      if (buf.includes('amor')) {
        discover('typeamor', '💛', 'Lo escribiste. Yo también, todo el día.');
        buf = '';
      }
    }
  });

  // 5) Idle 10s — lluvia de corazones BIEN visible
  let idleStart = Date.now();
  let idleFired = false;
  const resetIdle = () => { idleStart = Date.now(); idleFired = false; };
  ['mousemove', 'touchstart', 'scroll', 'keydown'].forEach((ev) =>
    window.addEventListener(ev, resetIdle, { passive: true })
  );
  function rainHearts() {
    const symbols = ['🩵', '💛', '⭐', '✨', '🩵', '💛'];
    for (let i = 0; i < 36; i++) {
      const h = document.createElement('span');
      h.textContent = symbols[Math.floor(Math.random() * symbols.length)];
      h.className = 'idle-rain';
      h.style.left = Math.random() * 100 + 'vw';
      h.style.animationDelay = Math.random() * 2.2 + 's';
      h.style.animationDuration = 4 + Math.random() * 2.5 + 's';
      h.style.fontSize = 22 + Math.random() * 22 + 'px';
      document.body.appendChild(h);
      window.setTimeout(() => h.remove(), 7500);
    }
  }
  window.setInterval(() => {
    if (!idleFired && Date.now() - idleStart > 10000) {
      idleFired = true;
      rainHearts();
      discover('idle10', '🌙', 'Gracias por quedarte un rato conmigo');
    }
  }, 500);

  // 6) Scroll al fondo → abre modal de foto
  const bottomCard = document.getElementById('bottom-card');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        bottomCard?.classList.add('found');
        if (!found.has('scroll-bottom')) {
          openPhotoModal();
        }
        discover('scroll-bottom', '🌟', '¡Llegaste hasta el fondo!');
      }
    });
  }, { threshold: 0.45 });
  if (bottomCard) obs.observe(bottomCard);

  // ===== Modal de foto =====
  const photoModal = document.getElementById('photo-modal') as HTMLElement | null;
  const photoImg = document.getElementById('photo-img') as HTMLImageElement | null;
  const photoFallback = document.getElementById('photo-fallback') as HTMLElement | null;
  const photoClose = document.getElementById('photo-close');
  const photoDone = document.getElementById('photo-done');
  const photoAnother = document.getElementById('photo-another');
  const reopenPhoto = document.getElementById('reopen-photo');

  const base = document.querySelector('base')?.getAttribute('href')
    ?? new URL(document.baseURI).pathname.replace(/[^/]*$/, '');

  let lastPhoto = -1;
  function pickPhoto(): number {
    let n = Math.floor(Math.random() * 6) + 1;
    if (lastPhoto === n) n = (n % 6) + 1;
    lastPhoto = n;
    return n;
  }
  function setPhoto(n: number) {
    if (!photoImg || !photoFallback) return;
    photoFallback.setAttribute('hidden', '');
    photoImg.style.display = 'block';
    photoImg.onload = () => {
      photoFallback.setAttribute('hidden', '');
      photoImg.style.display = 'block';
    };
    photoImg.onerror = () => {
      photoImg.style.display = 'none';
      photoFallback.removeAttribute('hidden');
    };
    photoImg.src = `${base}photos/${n}.jpg`;
  }
  function openPhotoModal() {
    if (!photoModal) return;
    setPhoto(pickPhoto());
    photoModal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closePhotoModal() {
    if (!photoModal) return;
    photoModal.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }
  photoClose?.addEventListener('click', closePhotoModal);
  photoDone?.addEventListener('click', closePhotoModal);
  photoAnother?.addEventListener('click', () => setPhoto(pickPhoto()));
  reopenPhoto?.addEventListener('click', openPhotoModal);
  photoModal?.addEventListener('click', (e) => {
    if (e.target === photoModal) closePhotoModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && photoModal && !photoModal.hasAttribute('hidden')) {
      closePhotoModal();
    }
  });

  // Música
  const btn = document.getElementById('music-btn');
  const audio = document.getElementById('music') as HTMLAudioElement | null;
  btn?.addEventListener('click', async () => {
    if (!audio) return;
    if (audio.paused) {
      try {
        await audio.play();
        btn.setAttribute('aria-pressed', 'true');
        btn.textContent = '🎵 Música ON · pausar';
      } catch {
        btn.textContent = '🎵 (Añade public/music.mp3)';
      }
    } else {
      audio.pause();
      btn.setAttribute('aria-pressed', 'false');
      btn.textContent = '🎵 Música opcional';
    }
  });
</script>
