---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const secrets = [
  {
    key: 'hover-simba',
    icon: '🐱',
    title: '1 · Hover sobre Simba',
    where: 'Escena del homepage (gato naranja del centro).',
    how: 'Pasa el mouse encima o dale tap en móvil.',
    reveal: 'prrrr prr',
    tip: 'Mantén el cursor encima un segundo: aparece una burbujita.',
  },
  {
    key: 'dblclick-woonhak',
    icon: '🩵',
    title: '2 · Doble click a Woonhak',
    where: 'Escena del homepage (personaje izquierdo, pelo castaño).',
    how: 'Doble click con el mouse, o dos taps rápidos en móvil.',
    reveal: 'dí meow 💛',
    tip: 'Si no responde, prueba en el centro del sprite.',
  },
  {
    key: 'heart5',
    icon: '🩵',
    title: '3 · Click x5 al corazón',
    where: 'El 🩵 al lado del título "pequeño rincón de internet".',
    how: 'Clickéalo cinco veces seguidas.',
    reveal: 'Por siempre.',
    tip: 'Cada click muestra un mensaje distinto antes del final.',
  },
  {
    key: 'typeamor',
    icon: '💛',
    title: '4 · Escribe "amor"',
    where: 'En cualquier parte del homepage.',
    how: 'En PC: sólo escribe a-m-o-r. En móvil: toca el botón ⌨️ (abajo a la izquierda) y escribe "amor".',
    reveal: 'lo escribiste. yo también, todo el día.',
    tip: 'El botón ⌨️ abre el teclado del teléfono sin que haya un campo visible.',
  },
  {
    key: 'idle10',
    icon: '🌙',
    title: '5 · Quédate quieto 10 segundos',
    where: 'Homepage. No muevas el mouse, no hagas scroll, no toques.',
    how: 'Cuenta hasta 10 lentito. Llueven corazones.',
    reveal: 'gracias por quedarte un rato conmigo.',
    tip: 'El temporizador se reinicia con cualquier interacción.',
  },
  {
    key: 'scroll-bottom',
    icon: '🌟',
    title: '6 · Llega al fondo del scroll',
    where: 'Baja hasta lo más bajo del homepage.',
    how: 'Scrollea hasta abajo y se ilumina una tarjeta secreta.',
    reveal: '¡Lo encontraste!',
    tip: 'Pasa el feature grid, sigue bajando.',
  },
];
---

<Layout title="Guía de secretos · 🧸">
  <section class="container guide">
    <header class="head">
      <p class="eyebrow">🧸 GUÍA DE SECRETOS</p>
      <h1>Los <span class="grad">6 secretos</span> del homepage</h1>
      <p class="sub">
        Aquí están todos los detalles escondidos que hay en la página de
        inicio, con su pista exacta. Hazlos ahí, no aquí, esta es solo la
        guía. Tu progreso se guarda en este navegador.
      </p>
      <div class="meter card">
        <div class="meter-row">
          <span class="meter-label">Tu progreso</span>
          <span class="meter-count"><span id="found-count">0</span> / 6</span>
        </div>
        <div class="bar"><span id="bar-fill"></span></div>
        <div class="meter-actions">
          <a class="btn" href={base}>← Ir al homepage a buscarlos</a>
          <button id="reset" class="btn ghost" type="button">Resetear progreso</button>
        </div>
      </div>
    </header>

    <div class="grid">
      {
        secrets.map((s) => (
          <article class="tile card" data-key={s.key}>
            <div class="row1">
              <span class="ico">{s.icon}</span>
              <span class="status pending" data-status>Pendiente</span>
            </div>
            <h3>{s.title}</h3>
            <p><strong>Dónde:</strong> {s.where}</p>
            <p><strong>Cómo:</strong> {s.how}</p>
            <p class="reveal" data-reveal hidden>
              <strong>Revelado:</strong> <em>"{s.reveal}"</em>
            </p>
            <p class="tip">💡 {s.tip}</p>
          </article>
        ))
      }
    </div>

    <p class="footer-note">
      ¿Aún te faltan? Vuelve al homepage y prueba, la chip abajo a la derecha
      lleva la cuenta en tiempo real.
    </p>
  </section>
</Layout>

<style>
  .guide { padding-top: clamp(20px, 5vw, 40px); }
  .head { text-align: center; margin-bottom: 28px; }
  .eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    letter-spacing: 0.12em;
  }
  .grad {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: var(--text-soft); max-width: 60ch; margin: 0 auto 22px; }

  .meter {
    max-width: 560px;
    margin: 18px auto 0;
    text-align: left;
  }
  .meter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .meter-label { font-weight: 700; color: var(--text); }
  .meter-count {
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
    color: var(--primary);
  }
  .bar {
    height: 8px;
    background: var(--surface-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .bar #bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--primary), var(--gold));
    transition: width 0.5s ease;
  }
  .meter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
    justify-content: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .grid { grid-template-columns: 1fr; } }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.3s ease, transform 0.2s;
  }
  .tile.done {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 6%, var(--surface));
  }
  .row1 {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ico { font-size: 28px; }
  .status {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .status.pending {
    color: var(--text-soft);
    background: var(--surface-2);
  }
  .status.done {
    color: #fff;
    background: var(--primary);
  }
  .tile h3 { font-size: 14px; margin: 4px 0 4px; }
  .tile p { font-size: 13px; color: var(--text); margin: 0; }
  .tile p strong { color: var(--primary); }
  .tile .reveal { color: var(--text-soft); margin-top: 6px; }
  .tile .reveal[hidden] { display: none; }
  .tile .tip {
    margin-top: auto;
    font-size: 12px;
    color: var(--text-soft);
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }

  .footer-note {
    text-align: center;
    color: var(--text-soft);
    margin-top: 28px;
  }
</style>

<script>
  const SECRETS = ['hover-simba', 'dblclick-woonhak', 'heart5', 'typeamor', 'idle10', 'scroll-bottom'];

  function load(): Set<string> {
    try {
      return new Set<string>(JSON.parse(localStorage.getItem('secrets-found') || '[]'));
    } catch {
      return new Set();
    }
  }

  function render() {
    const found = load();
    const count = found.size;
    const countEl = document.getElementById('found-count');
    const barFill = document.getElementById('bar-fill');
    if (countEl) countEl.textContent = String(count);
    if (barFill) barFill.style.width = (count / SECRETS.length) * 100 + '%';

    document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
      const key = tile.dataset.key;
      const isDone = !!key && found.has(key);
      tile.classList.toggle('done', isDone);
      const status = tile.querySelector<HTMLElement>('[data-status]');
      const reveal = tile.querySelector<HTMLElement>('[data-reveal]');
      if (status) {
        status.classList.toggle('done', isDone);
        status.classList.toggle('pending', !isDone);
        status.textContent = isDone ? 'Encontrado ✓' : 'Pendiente';
      }
      if (reveal) {
        if (isDone) reveal.removeAttribute('hidden');
        else reveal.setAttribute('hidden', '');
      }
    });
  }

  render();

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) render();
  });
  window.addEventListener('storage', render);

  document.getElementById('reset')?.addEventListener('click', () => {
    localStorage.removeItem('secrets-found');
    render();
  });
</script>
