---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mini juego · Atrapa corazones 🎮">
  <section class="container game-wrap">
    <header class="head">
      <p class="eyebrow">🎮 MINIJUEGO</p>
      <h1>Atrapa los <span class="grad">corazones</span></h1>
      <p class="sub">
        Mueve a <strong>Sungho</strong> con ←/→ (o desliza el dedo) y atrapa
        los corazones. Si aparece <strong>Simba 🐱</strong> es bonus de +3.
        Las nubes ⚡ te quitan vida. Tres vidas.
      </p>
    </header>

    <div class="hud">
      <div class="stat">Puntos: <span id="score">0</span></div>
      <div class="stat">Récord: <span id="best">0</span></div>
      <div class="stat">Vidas: <span id="lives">❤❤❤</span></div>
      <button id="start" class="btn">Empezar</button>
    </div>

    <div id="stage" class="stage" tabindex="0" aria-label="Área de juego">
      <div id="player" class="player"></div>
      <div id="flash" class="flash" aria-hidden="true"></div>
      <div id="overlay" class="game-overlay">
        <div class="card msg" id="msg-card">
          <h2 id="ov-title">¿List@?</h2>
          <p id="ov-body">Pulsa "Empezar" o cualquier tecla para arrancar.</p>
        </div>
        <div class="card msg romantic-msg" id="romantic-card" hidden>
          <span class="rom-ico">🩵</span>
          <h2>Un secretito</h2>
          <p class="rom-quote">
            "no corras más rápido para alcanzar mi corazón,<br/>
            cuando ya lo tienes en la palma de tu mano."
          </p>
          <p class="rom-stat" id="rom-stat">Hiciste 0 puntos.</p>
          <button id="rom-again" class="btn" type="button">Otra ronda 🎮</button>
        </div>
      </div>
    </div>

    <div class="mobile-ctrls">
      <button id="left-btn" class="ctrl" type="button" aria-label="Izquierda">◀</button>
      <button id="right-btn" class="ctrl" type="button" aria-label="Derecha">▶</button>
    </div>

    <details class="card tips">
      <summary>Tips</summary>
      <ul>
        <li>🩵 corazón celeste: +1 punto.</li>
        <li>💛 corazón dorado: +2 puntos.</li>
        <li>🐱 Simba: +3 puntos (¡rara!).</li>
        <li>⚡ rayo: -1 vida.</li>
        <li>Gana velocidad cada 10 puntos. ¡Cuidado!</li>
      </ul>
    </details>
  </section>
</Layout>

<style>
  .game-wrap { padding-top: clamp(20px, 5vw, 40px); }
  .head { text-align: center; margin-bottom: 22px; }
  .eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    letter-spacing: 0.12em;
  }
  .grad {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: var(--text-soft); max-width: 64ch; margin-inline: auto; }

  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 18px;
    margin: 14px 0;
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
  }
  .stat { color: var(--text); }
  .stat span { color: var(--primary); margin-left: 6px; }

  .stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 3 / 4;
    margin: 0 auto;
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--accent) 50%, transparent),
        color-mix(in srgb, var(--surface) 60%, transparent));
    border-radius: 18px;
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: var(--shadow);
    touch-action: none;
    user-select: none;
  }
  .stage::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 14%;
    background: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, var(--primary) 35%, transparent) 0 6px,
      color-mix(in srgb, var(--primary) 22%, transparent) 6px 12px
    );
    pointer-events: none;
  }
  .player {
    position: absolute;
    left: 0;
    top: 0;
    width: 56px;
    height: 72px;
    z-index: 2;
    pointer-events: none;
    will-change: transform;
  }
  .player svg { width: 100%; height: 100%; image-rendering: pixelated; }

  /* Flash: usamos un overlay con opacity en vez de animar boxShadow
     en el stage (que repintaba todo y causaba parpadeos) */
  .flash {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    pointer-events: none;
    z-index: 4;
    box-shadow: inset 0 0 0 0 transparent;
    transition: box-shadow 0.18s ease-out;
  }
  .flash.sky  { box-shadow: inset 0 0 0 8px color-mix(in srgb, #6ec1ff 70%, transparent); }
  .flash.gold { box-shadow: inset 0 0 0 8px color-mix(in srgb, #ffd166 75%, transparent); }
  .flash.simba{ box-shadow: inset 0 0 0 8px color-mix(in srgb, #ff8c1a 75%, transparent); }
  .flash.bolt { box-shadow: inset 0 0 0 8px color-mix(in srgb, #ff5577 80%, transparent); }

  .item {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    z-index: 1;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    filter: drop-shadow(0 2px 0 rgba(0,0,0,0.15));
    font-size: 26px;
    will-change: transform;
  }
  .item.pop { animation: pop 0.25s ease forwards; }
  @keyframes pop {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: grid;
    place-items: center;
    z-index: 10;
  }
  .game-overlay.hide { display: none; }
  .msg {
    max-width: 86%;
    text-align: center;
    border-top: 4px solid var(--gold);
  }
  .msg[hidden] { display: none !important; }
  .msg h2 { margin: 0 0 8px; font-size: 14px; }
  .msg p { margin: 0; font-size: 14px; color: var(--text-soft); }

  .romantic-msg {
    border-top: 4px solid var(--primary);
    animation: rom-in 0.45s ease;
  }
  @keyframes rom-in {
    from { transform: translateY(20px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  .romantic-msg .rom-ico {
    display: block;
    font-size: 36px;
    margin-bottom: 6px;
    animation: heartbeat 1.4s ease-in-out infinite;
  }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.15); }
  }
  .romantic-msg h2 {
    font-size: 13px;
    color: var(--gold);
    margin: 0 0 12px;
  }
  .romantic-msg .rom-quote {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text);
    font-style: italic;
    margin: 0 0 14px;
  }
  .romantic-msg .rom-stat {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: var(--text-soft);
    margin: 0 0 14px;
  }
  .romantic-msg .btn { margin: 0 auto; }

  /* Shake sutil cuando te pega un rayo */
  .stage.shake { animation: shake 0.32s ease-out; }
  @keyframes shake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
    40%, 60% { transform: translate3d(4px, 0, 0); }
  }

  .mobile-ctrls {
    display: none;
    justify-content: center;
    gap: 14px;
    margin: 14px 0;
  }
  .ctrl {
    width: 72px; height: 72px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 26px;
    cursor: pointer;
    box-shadow: var(--shadow);
    touch-action: manipulation;
  }
  .ctrl:active { transform: translateY(2px); }
  @media (hover: none) and (pointer: coarse) {
    .mobile-ctrls { display: flex; }
  }

  .tips { margin: 22px auto 0; max-width: 520px; }
  .tips summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--primary);
  }
  .tips ul { margin: 10px 0 0; padding-left: 18px; color: var(--text-soft); }
</style>

<script>
  // ===== Sprite de Sungho como SVG inline =====
  const sunghoSprite = [
    '....YYYY....',
    '...YYYYYY...',
    '..YYYYYYYY..',
    '..YFFFFFFY..',
    '..YFEFFEFY..',
    '...FFFFFF...',
    '....FMMF....',
    '....FFFF....',
    '.GGGGGGGGGG.',
    'GGGGGGGGGGGG',
    'FGGGGGGGGGGF',
    '.GGGGGGGGGG.',
    '..PPPPPPPP..',
    '..PPP..PPP..',
    '..PPP..PPP..',
    '..BBB..BBB..',
  ];
  const palette: Record<string, string> = {
    '.': 'transparent',
    Y: '#f5c542', F: '#ffd9b3', E: '#1c1c1c', M: '#c0392b',
    G: '#d4a017', P: '#0a1f44', B: '#1c1c1c',
  };
  function spriteSvg(sprite: string[]): string {
    const cols = sprite[0].length;
    const rows = sprite.length;
    let rects = '';
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const c = palette[sprite[y][x]];
        if (c && c !== 'transparent') {
          rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${c}"/>`;
        }
      }
    }
    return `<svg viewBox="0 0 ${cols} ${rows}" shape-rendering="crispEdges" preserveAspectRatio="xMidYMid meet">${rects}</svg>`;
  }

  // ===== Estado =====
  const stage = document.getElementById('stage') as HTMLElement;
  const player = document.getElementById('player') as HTMLElement;
  const flashEl = document.getElementById('flash') as HTMLElement;
  const scoreEl = document.getElementById('score') as HTMLElement;
  const bestEl = document.getElementById('best') as HTMLElement;
  const livesEl = document.getElementById('lives') as HTMLElement;
  const startBtn = document.getElementById('start') as HTMLButtonElement;
  const overlay = document.getElementById('overlay') as HTMLElement;
  const msgCard = document.getElementById('msg-card') as HTMLElement;
  const romanticCard = document.getElementById('romantic-card') as HTMLElement;
  const romStat = document.getElementById('rom-stat') as HTMLElement;
  const romAgain = document.getElementById('rom-again') as HTMLButtonElement;
  const ovTitle = document.getElementById('ov-title') as HTMLElement;
  const ovBody = document.getElementById('ov-body') as HTMLElement;

  player.innerHTML = spriteSvg(sunghoSprite);

  let stageW = 0;
  let stageH = 0;
  const PLAYER_W = 56;
  const PLAYER_H = 72;
  const PLAYER_BOTTOM = 18;
  const ITEM_SIZE = 36;

  let playerX = 0;

  function placePlayer() {
    if (!stageW) return;
    const cx = Math.min(stageW - PLAYER_W / 2, Math.max(PLAYER_W / 2, playerX || stageW / 2));
    playerX = cx;
    const left = cx - PLAYER_W / 2;
    const top = stageH - PLAYER_H - PLAYER_BOTTOM;
    player.style.transform = `translate(${left}px, ${top}px)`;
  }

  function syncStageSize() {
    const r = stage.getBoundingClientRect();
    stageW = r.width;
    stageH = r.height;
    placePlayer();
  }
  new ResizeObserver(syncStageSize).observe(stage);

  // ===== Items =====
  type Kind = 'sky' | 'gold' | 'simba' | 'bolt';
  type Item = { el: HTMLElement; x: number; y: number; vy: number; kind: Kind };
  let items: Item[] = [];

  function emojiFor(k: Kind): string {
    return k === 'sky' ? '🩵' : k === 'gold' ? '💛' : k === 'simba' ? '🐱' : '⚡';
  }

  function spawn() {
    if (!stageW) return;
    const r = Math.random();
    const kind: Kind =
      r < 0.55 ? 'sky' : r < 0.78 ? 'gold' : r < 0.86 ? 'simba' : 'bolt';
    const el = document.createElement('div');
    el.className = 'item';
    el.textContent = emojiFor(kind);
    el.style.width = ITEM_SIZE + 'px';
    el.style.height = ITEM_SIZE + 'px';
    stage.appendChild(el);
    const margin = ITEM_SIZE / 2 + 4;
    const x = margin + Math.random() * (stageW - margin * 2);
    const y = -ITEM_SIZE;
    el.style.transform = `translate(${x - ITEM_SIZE / 2}px, ${y}px)`;
    items.push({ el, x, y, vy: baseSpeed * (0.8 + Math.random() * 0.5), kind });
  }

  // ===== Loop =====
  let score = 0;
  let lives = 3;
  let running = false;
  let baseSpeed = 130;
  let spawnTimer = 0;
  let nextSpawnIn = 0.7;
  let raf = 0;
  let lastT = 0;

  const best = Number(localStorage.getItem('best-score') || 0);
  bestEl.textContent = String(best);

  function setOverlay(title: string, body: string) {
    ovTitle.textContent = title;
    ovBody.textContent = body;
    msgCard.removeAttribute('hidden');
    romanticCard.setAttribute('hidden', '');
    overlay.classList.remove('hide');
  }
  function showRomantic(points: number) {
    msgCard.setAttribute('hidden', '');
    romanticCard.removeAttribute('hidden');
    romStat.textContent = `Hiciste ${points} ${points === 1 ? 'punto' : 'puntos'}.`;
    overlay.classList.remove('hide');
  }
  function hideOverlay() { overlay.classList.add('hide'); }

  function reset() {
    items.forEach((i) => i.el.remove());
    items = [];
    score = 0;
    lives = 3;
    baseSpeed = 130;
    spawnTimer = 0;
    nextSpawnIn = 0.7;
    scoreEl.textContent = '0';
    livesEl.textContent = '❤❤❤';
  }

  // Flash usando CSS class (sin WAAPI sobre boxShadow del stage,
  // que provocaba parpadeos al repintar todo el escenario).
  let flashTimer = 0;
  function flash(kind: 'sky' | 'gold' | 'simba' | 'bolt') {
    flashEl.classList.remove('sky', 'gold', 'simba', 'bolt');
    void flashEl.offsetWidth; // reflow
    flashEl.classList.add(kind);
    window.clearTimeout(flashTimer);
    flashTimer = window.setTimeout(() => {
      flashEl.classList.remove(kind);
    }, 180);
  }
  function shake() {
    stage.classList.remove('shake');
    void stage.offsetWidth;
    stage.classList.add('shake');
    window.setTimeout(() => stage.classList.remove('shake'), 350);
  }

  function rectsCollide(
    ax: number, ay: number, aw: number, ah: number,
    bx: number, by: number, bw: number, bh: number,
  ): boolean {
    return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by;
  }

  function loop(t: number) {
    if (!running) return;
    if (!lastT) lastT = t;
    const dt = Math.min(0.05, (t - lastT) / 1000);
    lastT = t;

    spawnTimer += dt;
    if (spawnTimer > nextSpawnIn) {
      spawnTimer = 0;
      nextSpawnIn = 0.55 + Math.random() * 0.55;
      spawn();
    }

    const playerLeft = playerX - PLAYER_W / 2;
    const playerTop = stageH - PLAYER_H - PLAYER_BOTTOM;
    const hbInset = 10;
    const pX = playerLeft + hbInset;
    const pY = playerTop + hbInset;
    const pW = PLAYER_W - hbInset * 2;
    const pH = PLAYER_H - hbInset;

    for (const it of items) {
      it.y += it.vy * dt;
      it.el.style.transform = `translate(${it.x - ITEM_SIZE / 2}px, ${it.y}px)`;

      const ix = it.x - ITEM_SIZE / 2;
      const iy = it.y;
      const hit = rectsCollide(ix, iy, ITEM_SIZE, ITEM_SIZE, pX, pY, pW, pH);

      if (hit) {
        if (it.kind === 'bolt') {
          lives = Math.max(0, lives - 1);
          livesEl.textContent = '❤'.repeat(lives) + '·'.repeat(3 - lives);
          flash('bolt');
          shake();
        } else {
          const gain = it.kind === 'sky' ? 1 : it.kind === 'gold' ? 2 : 3;
          score += gain;
          scoreEl.textContent = String(score);
          if (score > 0 && score % 10 === 0) baseSpeed += 18;
          flash(it.kind);
        }
        it.el.classList.add('pop');
        const dead = it.el;
        window.setTimeout(() => dead.remove(), 220);
        it.y = stageH + 9999;
      }
    }

    items = items.filter((it) => {
      if (it.y > stageH + 40) {
        it.el.remove();
        return false;
      }
      return it.y < stageH + 9000;
    });

    if (lives <= 0) {
      end();
    } else {
      raf = requestAnimationFrame(loop);
    }
  }

  function start() {
    syncStageSize();
    reset();
    playerX = stageW / 2;
    placePlayer();
    running = true;
    lastT = 0;
    hideOverlay();
    raf = requestAnimationFrame(loop);
    stage.focus();
  }

  // Cuando "en teoría" perderías todas las vidas, no termina seco —
  // mostramos un mensaje bonito tras un breve respiro.
  function end() {
    running = false;
    cancelAnimationFrame(raf);
    livesEl.textContent = '💔💔💔';
    const finalScore = score;
    const prev = Number(localStorage.getItem('best-score') || 0);
    if (finalScore > prev) {
      localStorage.setItem('best-score', String(finalScore));
      bestEl.textContent = String(finalScore);
    }
    // Pequeño respiro para que se "asiente" el momento.
    window.setTimeout(() => showRomantic(finalScore), 1400);
  }

  startBtn.addEventListener('click', start);
  romAgain.addEventListener('click', start);

  // ===== Movimiento: teclado =====
  const keys: Record<string, boolean> = {};
  window.addEventListener('keydown', (e) => {
    if (['ArrowLeft', 'ArrowRight', 'a', 'A', 'd', 'D'].includes(e.key)) {
      keys[e.key] = true;
      e.preventDefault();
    }
    if (!running && (e.key === 'Enter' || e.key === ' ')) {
      start();
    }
  });
  window.addEventListener('keyup', (e) => { keys[e.key] = false; });

  // ===== Movimiento: botones móviles =====
  const leftBtn = document.getElementById('left-btn') as HTMLElement;
  const rightBtn = document.getElementById('right-btn') as HTMLElement;
  let leftHeld = false, rightHeld = false;
  const hold = (btn: HTMLElement, set: (v: boolean) => void) => {
    const on = (e: Event) => { e.preventDefault(); set(true); };
    const off = (e: Event) => { e.preventDefault(); set(false); };
    btn.addEventListener('pointerdown', on);
    btn.addEventListener('pointerup', off);
    btn.addEventListener('pointercancel', off);
    btn.addEventListener('pointerleave', off);
    btn.addEventListener('touchstart', on, { passive: false });
    btn.addEventListener('touchend', off);
  };
  hold(leftBtn, (v) => (leftHeld = v));
  hold(rightBtn, (v) => (rightHeld = v));

  // ===== Movimiento: drag en stage =====
  let dragging = false;
  const setFromPointer = (clientX: number) => {
    if (!stageW) return;
    const rect = stage.getBoundingClientRect();
    const relX = clientX - rect.left;
    playerX = Math.min(stageW - PLAYER_W / 2, Math.max(PLAYER_W / 2, relX));
    placePlayer();
  };
  stage.addEventListener('pointerdown', (e) => {
    dragging = true;
    stage.setPointerCapture(e.pointerId);
    setFromPointer(e.clientX);
  });
  stage.addEventListener('pointermove', (e) => {
    if (dragging) setFromPointer(e.clientX);
  });
  stage.addEventListener('pointerup', () => { dragging = false; });
  stage.addEventListener('pointercancel', () => { dragging = false; });

  // Loop de movimiento (independiente)
  const PLAYER_SPEED = 380;
  let mvLast = performance.now();
  function moveTick(now: number) {
    const dt = Math.min(0.05, (now - mvLast) / 1000);
    mvLast = now;
    if (running && stageW) {
      let dx = 0;
      if (keys['ArrowLeft'] || keys['a'] || keys['A'] || leftHeld) dx -= 1;
      if (keys['ArrowRight'] || keys['d'] || keys['D'] || rightHeld) dx += 1;
      if (dx !== 0) {
        playerX = Math.min(stageW - PLAYER_W / 2, Math.max(PLAYER_W / 2, playerX + dx * PLAYER_SPEED * dt));
        placePlayer();
      }
    }
    requestAnimationFrame(moveTick);
  }
  requestAnimationFrame(moveTick);

  // Inicializar
  syncStageSize();
  playerX = stageW / 2;
  placePlayer();
</script>
