---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mini juego · Atrapa corazones 🎮">
  <section class="container game-wrap">
    <header class="head">
      <p class="eyebrow">🎮 MINIJUEGO</p>
      <h1>Atrapa los <span class="grad">corazones</span></h1>
      <p class="sub">
        Mueve a <strong>Sungho</strong> con ←/→ (o desliza el dedo) y atrapa los
        corazones. Si aparece <strong>Simba 🐱</strong> es bonus de +3. Las
        nubes ⚡ te quitan vida. Tres vidas.
      </p>
    </header>

    <div class="hud">
      <div class="stat">Puntos: <span id="score">0</span></div>
      <div class="stat">Récord: <span id="best">0</span></div>
      <div class="stat">Vidas: <span id="lives">❤❤❤</span></div>
      <button id="start" class="btn">Empezar</button>
    </div>

    <div id="stage" class="stage" tabindex="0" aria-label="Área de juego">
      <div id="player" class="player"></div>
      <div id="overlay" class="game-overlay">
        <div class="card msg">
          <h2 id="ov-title">¿List@?</h2>
          <p id="ov-body">Click "Empezar" o pulsa cualquier tecla para arrancar.</p>
        </div>
      </div>
    </div>

    <div class="mobile-ctrls" aria-hidden="false">
      <button id="left-btn" class="ctrl">◀</button>
      <button id="right-btn" class="ctrl">▶</button>
    </div>

    <details class="card tips">
      <summary>Tips</summary>
      <ul>
        <li>💙 corazón azul: +1 punto.</li>
        <li>💛 corazón dorado: +2 puntos.</li>
        <li>🐱 Simba: +3 puntos (¡rara!).</li>
        <li>⚡ tormenta: -1 vida.</li>
        <li>Gana velocidad cada 10 puntos. ¡Cuidado!</li>
      </ul>
    </details>
  </section>
</Layout>

<style>
  .game-wrap { padding-top: clamp(20px, 5vw, 40px); }
  .head { text-align: center; margin-bottom: 22px; }
  .eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold);
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    letter-spacing: 0.12em;
  }
  .grad {
    background: linear-gradient(90deg, var(--primary), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: var(--text-soft); max-width: 64ch; margin-inline: auto; }

  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 18px;
    margin: 14px 0;
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
  }
  .stat { color: var(--text); }
  .stat span { color: var(--primary); margin-left: 6px; }

  .stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 3 / 4;
    margin: 0 auto;
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--accent) 50%, transparent),
        color-mix(in srgb, var(--surface) 60%, transparent));
    border-radius: 18px;
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: var(--shadow);
    image-rendering: pixelated;
    touch-action: none;
  }
  .stage::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 14%;
    background: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, var(--primary) 35%, transparent) 0 6px,
      color-mix(in srgb, var(--primary) 22%, transparent) 6px 12px
    );
    pointer-events: none;
  }
  .player {
    position: absolute;
    bottom: 6%;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 86px;
    z-index: 2;
    transition: left 0.05s linear;
  }
  .item {
    position: absolute;
    top: 0;
    font-size: 28px;
    z-index: 1;
    line-height: 1;
    user-select: none;
    filter: drop-shadow(0 2px 0 rgba(0,0,0,0.15));
  }
  .item.pop {
    animation: pop 0.25s ease forwards;
  }
  @keyframes pop {
    0%   { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: grid;
    place-items: center;
    z-index: 10;
  }
  .game-overlay.hide { display: none; }
  .msg {
    max-width: 86%;
    text-align: center;
    border-top: 4px solid var(--gold);
  }
  .msg h2 { margin: 0 0 8px; font-size: 14px; }
  .msg p { margin: 0; font-size: 14px; color: var(--text-soft); }

  .mobile-ctrls {
    display: none;
    justify-content: center;
    gap: 14px;
    margin: 14px 0;
  }
  .ctrl {
    width: 64px; height: 64px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 22px;
    cursor: pointer;
    box-shadow: var(--shadow);
  }
  .ctrl:active { transform: translateY(2px); }
  @media (hover: none) and (pointer: coarse) {
    .mobile-ctrls { display: flex; }
  }

  .tips {
    margin: 22px auto 0;
    max-width: 520px;
  }
  .tips summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--primary);
  }
  .tips ul { margin: 10px 0 0; padding-left: 18px; color: var(--text-soft); }
</style>

<script>
  // Render Sungho como SVG inline (mismo sprite que PixelChar)
  const sunghoSprite = [
    '....YYYY....',
    '...YYYYYY...',
    '..YYYYYYYY..',
    '..YFFFFFFY..',
    '..YFEFFEFY..',
    '...FFFFFF...',
    '....FMMF....',
    '....FFFF....',
    '.GGGGGGGGGG.',
    'GGGGGGGGGGGG',
    'FGGGGGGGGGGF',
    '.GGGGGGGGGG.',
    '..PPPPPPPP..',
    '..PPP..PPP..',
    '..PPP..PPP..',
    '..BBB..BBB..',
  ];
  const palette: Record<string, string> = {
    '.': 'transparent',
    Y: '#f5c542', F: '#ffd9b3', E: '#1c1c1c', M: '#c0392b',
    G: '#d4a017', P: '#0a1f44', B: '#1c1c1c',
  };
  function spriteSvg(sprite: string[]): string {
    const cols = sprite[0].length;
    const rows = sprite.length;
    let rects = '';
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const c = palette[sprite[y][x]];
        if (c && c !== 'transparent') {
          rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${c}"/>`;
        }
      }
    }
    return `<svg viewBox="0 0 ${cols} ${rows}" shape-rendering="crispEdges" width="100%" height="100%">${rects}</svg>`;
  }

  const playerEl = document.getElementById('player')!;
  playerEl.innerHTML = spriteSvg(sunghoSprite);

  const stage = document.getElementById('stage') as HTMLElement;
  const scoreEl = document.getElementById('score')!;
  const bestEl = document.getElementById('best')!;
  const livesEl = document.getElementById('lives')!;
  const startBtn = document.getElementById('start') as HTMLButtonElement;
  const overlay = document.getElementById('overlay') as HTMLElement;
  const ovTitle = document.getElementById('ov-title')!;
  const ovBody = document.getElementById('ov-body')!;

  type Item = { el: HTMLElement; x: number; y: number; vy: number; kind: 'blue' | 'gold' | 'simba' | 'bolt' };

  let items: Item[] = [];
  let playerX = 0.5; // 0..1
  let score = 0;
  let lives = 3;
  let running = false;
  let lastSpawn = 0;
  let baseSpeed = 80; // px/s
  let raf = 0;
  let lastT = 0;

  const best = Number(localStorage.getItem('best-score') || 0);
  bestEl.textContent = String(best);

  function setOverlay(title: string, body: string) {
    ovTitle.textContent = title;
    ovBody.textContent = body;
    overlay.classList.remove('hide');
  }
  function hideOverlay() { overlay.classList.add('hide'); }

  function reset() {
    items.forEach((i) => i.el.remove());
    items = [];
    score = 0;
    lives = 3;
    baseSpeed = 80;
    scoreEl.textContent = '0';
    livesEl.textContent = '❤❤❤';
  }

  function spawn() {
    const r = Math.random();
    const kind: Item['kind'] =
      r < 0.55 ? 'blue' : r < 0.78 ? 'gold' : r < 0.86 ? 'simba' : 'bolt';
    const emoji =
      kind === 'blue' ? '💙' : kind === 'gold' ? '💛' : kind === 'simba' ? '🐱' : '⚡';
    const el = document.createElement('div');
    el.className = 'item';
    el.textContent = emoji;
    el.style.left = Math.random() * 90 + '%';
    stage.appendChild(el);
    items.push({ el, x: parseFloat(el.style.left), y: -10, vy: baseSpeed * (0.8 + Math.random() * 0.5), kind });
  }

  function loop(t: number) {
    if (!running) return;
    if (!lastT) lastT = t;
    const dt = (t - lastT) / 1000;
    lastT = t;
    lastSpawn += dt;
    if (lastSpawn > 0.7 + Math.random() * 0.6) {
      lastSpawn = 0;
      spawn();
    }

    const sw = stage.clientWidth;
    const sh = stage.clientHeight;
    const playerW = playerEl.clientWidth;
    const playerLeft = playerX * sw - playerW / 2;
    playerEl.style.left = `calc(${playerX * 100}% )`;

    for (const it of items) {
      it.y += it.vy * dt;
      it.el.style.top = it.y + 'px';

      // collision: player area
      const itemRect = { x: (it.x / 100) * sw, y: it.y, w: 30, h: 30 };
      const playerRect = { x: playerLeft, y: sh * 0.86, w: playerW, h: 90 };
      const hit =
        itemRect.x < playerRect.x + playerRect.w &&
        itemRect.x + itemRect.w > playerRect.x &&
        itemRect.y < playerRect.y + playerRect.h &&
        itemRect.y + itemRect.h > playerRect.y;

      if (hit) {
        if (it.kind === 'bolt') {
          lives--;
          livesEl.textContent = '❤'.repeat(Math.max(0, lives)) + '·'.repeat(3 - Math.max(0, lives));
          flash('#ff5577');
        } else {
          const gain = it.kind === 'blue' ? 1 : it.kind === 'gold' ? 2 : 3;
          score += gain;
          scoreEl.textContent = String(score);
          if (score % 10 === 0) baseSpeed += 25;
          flash(it.kind === 'gold' ? '#ffd166' : it.kind === 'simba' ? '#ff8c1a' : '#6ec1ff');
        }
        it.el.classList.add('pop');
        setTimeout(() => it.el.remove(), 200);
        it.y = sh + 999;
      }

      if (it.y > sh + 40) {
        it.el.remove();
      }
    }
    items = items.filter((i) => i.y < sh + 40);

    if (lives <= 0) {
      end();
    } else {
      raf = requestAnimationFrame(loop);
    }
  }

  function flash(color: string) {
    stage.animate(
      [{ boxShadow: `inset 0 0 0 6px ${color}` }, { boxShadow: 'inset 0 0 0 0 transparent' }],
      { duration: 250, easing: 'ease-out' }
    );
  }

  function start() {
    reset();
    running = true;
    lastT = 0;
    hideOverlay();
    raf = requestAnimationFrame(loop);
    stage.focus();
  }

  function end() {
    running = false;
    cancelAnimationFrame(raf);
    const prev = Number(localStorage.getItem('best-score') || 0);
    if (score > prev) {
      localStorage.setItem('best-score', String(score));
      bestEl.textContent = String(score);
      setOverlay('¡Nuevo récord! 🏆', `${score} puntos. Press start para otra ronda.`);
    } else {
      setOverlay('Fin del juego', `Hiciste ${score} pts. Récord: ${prev}.`);
    }
  }

  startBtn.addEventListener('click', start);

  // Controles
  const keys: Record<string, boolean> = {};
  window.addEventListener('keydown', (e) => {
    keys[e.key] = true;
    if (!running && (e.key === 'Enter' || e.key === ' ')) {
      start();
    }
  });
  window.addEventListener('keyup', (e) => { keys[e.key] = false; });

  setInterval(() => {
    if (!running) return;
    if (keys['ArrowLeft'] || keys['a'] || keys['A']) playerX = Math.max(0.05, playerX - 0.025);
    if (keys['ArrowRight'] || keys['d'] || keys['D']) playerX = Math.min(0.95, playerX + 0.025);
  }, 16);

  // Touch / pointer drag en el stage
  let dragging = false;
  const setFromPointer = (e: PointerEvent) => {
    const rect = stage.getBoundingClientRect();
    playerX = Math.min(0.95, Math.max(0.05, (e.clientX - rect.left) / rect.width));
  };
  stage.addEventListener('pointerdown', (e) => { dragging = true; setFromPointer(e); });
  stage.addEventListener('pointermove', (e) => { if (dragging) setFromPointer(e); });
  window.addEventListener('pointerup', () => { dragging = false; });

  // Botones móviles
  const leftBtn = document.getElementById('left-btn');
  const rightBtn = document.getElementById('right-btn');
  let leftHeld = false, rightHeld = false;
  leftBtn?.addEventListener('pointerdown', () => (leftHeld = true));
  rightBtn?.addEventListener('pointerdown', () => (rightHeld = true));
  ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => {
    leftBtn?.addEventListener(ev, () => (leftHeld = false));
    rightBtn?.addEventListener(ev, () => (rightHeld = false));
  });
  setInterval(() => {
    if (!running) return;
    if (leftHeld) playerX = Math.max(0.05, playerX - 0.025);
    if (rightHeld) playerX = Math.min(0.95, playerX + 0.025);
  }, 16);
</script>
